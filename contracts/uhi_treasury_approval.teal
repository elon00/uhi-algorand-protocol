#pragma version 9
// =========================================================================
// UHI Protocol: Universal High Income Treasury & Distribution on Algorand
// Application Approval Program (Production-Hardened with Strict Reality Gates)
// =========================================================================

// Handle Creation
txn ApplicationID
int 0
==
bnz handle_create

// Handle OptIn (Citizen Registration - Default UNVERIFIED)
txn OnCompletion
int OptIn
==
bnz handle_optin

// Handle CloseOut
txn OnCompletion
int CloseOut
==
bnz handle_closeout

// Handle Update / Delete (Strictly Restricted to Creator)
txn OnCompletion
int UpdateApplication
==
txn OnCompletion
int DeleteApplication
==
||
bnz handle_admin_only

// Handle NoOp (Standard Calls)
txn OnCompletion
int NoOp
==
bnz handle_noop

err

// -------------------------------------------------------------------------
// Creation Initialization (ZERO PHANTOM BALANCES)
// -------------------------------------------------------------------------
handle_create:
    byte "creator"
    txn Sender
    app_global_put

    byte "oracle_verifier"
    txn Sender
    app_global_put

    byte "current_epoch"
    int 1
    app_global_put

    byte "base_payout"
    int 500000000 // 500.000000 UHI (6 decimals)
    app_global_put

    byte "dynamic_multiplier_bps"
    int 10000 // 1.00x Base (10000 basis points)
    app_global_put

    byte "total_pooled"
    int 0 // Strict Reality: Zero phantom balance. Must be funded via real on-chain transfers!
    app_global_put

    byte "total_tax_collected_x402"
    int 0
    app_global_put

    byte "total_claims_count"
    int 0
    app_global_put

    int 1
    return

// -------------------------------------------------------------------------
// Citizen OptIn: Strict Sybil Prevention
// Default status is 0 (Unverified). Automatic verification is strictly eliminated!
// -------------------------------------------------------------------------
handle_optin:
    txn Sender
    byte "last_claim_epoch"
    int 0
    app_local_put

    // SECURITY FIX: Never grant automatic verification on opt-in!
    // Citizen must be vetted via verify_human_citizen oracle method.
    txn Sender
    byte "is_verified_human"
    int 0
    app_local_put

    int 1
    return

handle_closeout:
    int 1
    return

handle_admin_only:
    txn Sender
    byte "creator"
    app_global_get
    ==
    return

// -------------------------------------------------------------------------
// Route NoOp Operations
// -------------------------------------------------------------------------
handle_noop:
    txna ApplicationArgs 0
    byte "verify_human_citizen"
    ==
    bnz op_verify_human_citizen

    txna ApplicationArgs 0
    byte "deposit_x402_tax"
    ==
    bnz op_deposit_x402_tax

    txna ApplicationArgs 0
    byte "claim_uhi_dividend"
    ==
    bnz op_claim_uhi_dividend

    txna ApplicationArgs 0
    byte "advance_epoch"
    ==
    bnz op_advance_epoch

    txna ApplicationArgs 0
    byte "update_conway_multiplier"
    ==
    bnz op_update_conway_multiplier

    err

// -------------------------------------------------------------------------
// Method: verify_human_citizen
// Proof-of-Humanity gating: Can only be called by authorized Oracle/Admin
// Args: ["verify_human_citizen", target_account_address]
// -------------------------------------------------------------------------
op_verify_human_citizen:
    // Only authorized oracle or creator can verify humanity
    txn Sender
    byte "oracle_verifier"
    app_global_get
    ==
    txn Sender
    byte "creator"
    app_global_get
    ==
    ||
    assert

    // Target must be provided in Accounts array (index 1)
    txn NumAccounts
    int 1
    >=
    assert

    // Mark verified in target's local storage
    txna Accounts 1
    byte "is_verified_human"
    int 1
    app_local_put

    int 1
    return

// -------------------------------------------------------------------------
// Method: deposit_x402_tax
// Strict 3-Transaction Atomic Group Validation:
// Txn 0: Consumer pays Provider (90% net)
// Txn 1: Consumer pays Treasury Application Address (10% tax)
// Txn 2: Consumer calls deposit_x402_tax on Application
// -------------------------------------------------------------------------
op_deposit_x402_tax:
    // 1. Enforce complete 3-transaction group
    global GroupSize
    int 3
    ==
    assert

    // 2. Txn 0 (Provider payment) and Txn 1 (Treasury payment) must match asset/pay type
    gtxn 0 TypeEnum
    int pay
    ==
    gtxn 0 TypeEnum
    int axfer
    ==
    ||
    assert

    gtxn 1 TypeEnum
    gtxn 0 TypeEnum
    ==
    assert

    // 3. Payer Authorization: Consumer must be the sender of Txn 0, Txn 1, and Txn 2
    gtxn 0 Sender
    gtxn 1 Sender
    ==
    assert

    gtxn 1 Sender
    txn Sender
    ==
    assert

    // 4. Verify Txn 1 recipient is strictly this contract's application address
    gtxn 1 Receiver
    global CurrentApplicationAddress
    ==
    assert

    // 5. Positive amounts assertion
    gtxn 0 Amount
    int 0
    >
    assert
    gtxn 1 Amount
    int 0
    >
    assert

    // 6. Mathematical Exact Tax Split Verification:
    // Tax is 10%, Net is 90%. Therefore: Net == Tax * 9
    gtxn 1 Amount
    int 9
    *
    gtxn 0 Amount
    ==
    assert

    // 7. Update real on-chain accounting with Txn 1 Amount
    byte "total_tax_collected_x402"
    byte "total_tax_collected_x402"
    app_global_get
    gtxn 1 Amount
    +
    app_global_put

    byte "total_pooled"
    byte "total_pooled"
    app_global_get
    gtxn 1 Amount
    +
    app_global_put

    int 1
    return

// -------------------------------------------------------------------------
// Method: claim_uhi_dividend
// Args: ["claim_uhi_dividend", pqc_falcon_proof_bytes]
// -------------------------------------------------------------------------
op_claim_uhi_dividend:
    // 1. Citizen MUST be verified through genuine Proof-of-Humanity
    txn Sender
    byte "is_verified_human"
    app_local_get
    int 1
    ==
    assert

    // 2. Strict Sybil & Double-Claim check: Cannot claim twice in the same epoch
    txn Sender
    byte "last_claim_epoch"
    app_local_get
    byte "current_epoch"
    app_global_get
    <
    assert

    // 3. PQC proof must be provided
    txn NumAppArgs
    int 2
    >=
    assert
    txna ApplicationArgs 1
    len
    int 64
    >=
    assert

    // Update citizen's local state
    txn Sender
    byte "last_claim_epoch"
    byte "current_epoch"
    app_global_get
    app_local_put

    byte "total_claims_count"
    byte "total_claims_count"
    app_global_get
    int 1
    +
    app_global_put

    int 1
    return

// -------------------------------------------------------------------------
// Method: update_conway_multiplier
// Args: ["update_conway_multiplier", new_multiplier_bps]
// -------------------------------------------------------------------------
op_update_conway_multiplier:
    txn Sender
    byte "creator"
    app_global_get
    ==
    txn Sender
    byte "oracle_verifier"
    app_global_get
    ==
    ||
    assert

    txn NumAppArgs
    int 2
    ==
    assert

    // Only allow multipliers between 10000 (1.00x) and 15000 (1.50x)
    txna ApplicationArgs 1
    btoi
    store 1

    load 1
    int 10000
    >=
    load 1
    int 15000
    <=
    &&
    assert

    byte "dynamic_multiplier_bps"
    load 1
    app_global_put

    int 1
    return

// -------------------------------------------------------------------------
// Method: advance_epoch
// -------------------------------------------------------------------------
op_advance_epoch:
    txn Sender
    byte "creator"
    app_global_get
    ==
    assert

    byte "current_epoch"
    byte "current_epoch"
    app_global_get
    int 1
    +
    app_global_put

    int 1
    return
